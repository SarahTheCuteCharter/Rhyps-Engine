<?xml version="1.0" encoding="utf-8"?>
<project>
    <meta title="Friday Night Funkin': NKL-4ever" package="com.sarahthecharter.nkl4ever" version="0.2.8" company="ShadowMario" />

    <app main="Main" file="NKL-4ever" path="export" preloader="Preloader" />

    <window width="1280" height="720" fps="60" hardware="true" allow-high-dpi="true" />
    <window if="android" orientation="sensorLandscape" />

    <source path="source" />

    <assets path="assets" rename="assets" include="*" />
    <assets path="art" rename="art" include="*" />

    <haxelib name="lime" />
    <haxelib name="openfl" />
    <haxelib name="flixel" />
    <haxelib name="flixel-ui" />
    <haxelib name="flixel-addons" />
    <haxelib name="flixel-ui" />
    <haxelib name="hxcpp" />
    <haxelib name="tjson" />
    <haxelib name="newgrounds" />
    <haxelib name="SScript" />
    <haxelib name="devicelanguage" />
    <haxelib name="androiddialogs" />
    <haxelib name="discord_rpc" />
    <haxelib name="linc_luajit" />
    <haxelib name="hxCodec" />

    <set name="MODS_ALLOWED" />
    <set name="android" if="android" />
    <set name="mobile" if="android || ios" />
</project>
